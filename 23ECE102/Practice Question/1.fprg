    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Real" array="False" size=""/>
            <declare name="b" type="Real" array="False" size=""/>
            <output expression="&quot;Enter the cost of the first item&quot;" newline="True"/>
            <input variable="a"/>
            <output expression="&quot;Enter the cost of the second item&quot;" newline="True"/>
            <input variable="b"/>
            <declare name="sum" type="Real" array="False" size=""/>
            <assign variable="sum" expression="a+b"/>
            <output expression="&quot;The total of the two items are &quot;&amp;sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
