    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="total" type="Real" array="False" size=""/>
            <output expression="&quot;Enter the total bill amount&quot;" newline="True"/>
            <input variable="total"/>
            <declare name="book" type="Real" array="False" size=""/>
            <output expression="&quot;Enter the value of the book to be returned&quot;" newline="True"/>
            <input variable="book"/>
            <declare name="disc" type="Real" array="False" size=""/>
            <assign variable="disc" expression="total-book"/>
            <output expression="&quot;The discounted value after reducing the value of the book is &quot;&amp;disc" newline="True"/>
        </body>
    </function>
</flowgorithm>
