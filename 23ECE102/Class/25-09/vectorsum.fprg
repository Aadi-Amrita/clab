<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="vector-for"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-25 09:44:23 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOS0yNTswODozMTozNCBBTTsyNTA0"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOS0yNTswOTo0NDoyMyBBTTs2OzI2MjA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i" type="Integer" array="False" size=""/>
            <assign variable="n" expression="5"/>
            <assign variable="i" expression="0"/>
            <declare name="a" type="Integer" array="True" size="n"/>
            <declare name="b" type="Integer" array="True" size="n"/>
            <declare name="s" type="Integer" array="True" size="n"/>
            <while expression="i&lt;n">
                <output expression="&quot;Enter element &quot; &amp; i+1 &amp; &quot; for vector A&quot;" newline="True"/>
                <input variable="a[i]"/>
                <output expression="&quot;Enter element &quot; &amp; i+1 &amp; &quot; for vector B&quot;" newline="True"/>
                <input variable="b[i]"/>
                <assign variable="s[i]" expression="a[i]+b[i]"/>
                <assign variable="i" expression="i+1"/>
            </while>
            <assign variable="i" expression="0"/>
            <while expression="i&lt;n">
                <output expression="s[i]" newline="True"/>
                <assign variable="i" expression="i+1"/>
            </while>
        </body>
    </function>
</flowgorithm>
