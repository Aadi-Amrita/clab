<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="3"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-14 09:39:18 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOC0xNDswOTozMDozMSBBTTsyNDk4"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOC0xNDswOTozOToxOCBBTTsxOzI2MjA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n" type="Integer" array="False" size=""/>
            <do expression="n&lt;1">
                <output expression="&quot;Enter nonzero positive n&quot;" newline="True"/>
                <input variable="n"/>
            </do>
            <declare name="ans" type="Integer" array="False" size=""/>
            <assign variable="ans" expression="1"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <assign variable="ans" expression="ans*(i)"/>
            </for>
            <output expression="ans" newline="True"/>
        </body>
    </function>
</flowgorithm>
