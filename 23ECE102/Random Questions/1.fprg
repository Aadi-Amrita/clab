<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-14 08:47:43 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOC0xNDswODoyMToyNCBBTTsyNDk5"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOC0xNDswODo0Nzo0MyBBTTsyOzI2MTc="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="angle" type="Integer" array="False" size=""/>
            <do expression="angle &gt; 180 or angle &lt; 0">
                <output expression="&quot;Enter valid angle&quot;" newline="True"/>
                <input variable="angle"/>
            </do>
            <if expression="angle&gt;0 and angle&lt;90">
                <then>
                    <output expression="&quot;Acute&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="angle=90">
                        <then>
                            <output expression="&quot;right&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="angle&gt;90 and angle &lt;180">
                                <then>
                                    <output expression="&quot;obtuse&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="angle=180">
                                        <then>
                                            <output expression="&quot;Straight&quot;" newline="True"/>
                                        </then>
                                        <else/>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
