<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-28 09:40:13 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOC0yODswOTozNzoxMyBBTTsyNTEw"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOC0yODswOTo0MDoxMyBBTTszOzI2MTQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="r, a" type="Real" array="False" size=""/>
            <do expression="r &lt;= 0">
                <output expression="&quot;Output radius of the circle, it must be positive&quot;" newline="True"/>
                <input variable="r"/>
            </do>
            <assign variable="a" expression="3.14 * r * r"/>
            <output expression="&quot;The area is &quot;&amp; ToFixed(a,2)" newline="True"/>
        </body>
    </function>
</flowgorithm>
