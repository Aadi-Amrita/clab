<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="2"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 08:31:04 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0wMTswODoyMTo0NyBBTTsyNDkz"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0wMTswODozMTowNCBBTTsxOzI1OTU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter the length of fibbonaci&quot;" newline="True"/>
            <input variable="n"/>
            <declare name="nums" type="Integer" array="True" size="n"/>
            <assign variable="nums[0]" expression="1"/>
            <assign variable="nums[1]" expression="1"/>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <if expression="i&lt;2">
                    <then>
                        <output expression="nums[i]" newline="True"/>
                    </then>
                    <else>
                        <assign variable="nums[i]" expression="nums[i-1]+nums[i-2]"/>
                        <output expression="nums[i]" newline="True"/>
                    </else>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
