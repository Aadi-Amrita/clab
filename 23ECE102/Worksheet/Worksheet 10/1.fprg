<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-16 08:57:34 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0wMTswODo0NzoyMyBBTTsyNDk1"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0xNjswODo1MToxMyBBTTsxO3llYXIxO0VDRUNMLVNZUzEzOzIwMjYtMTAtMDE7MDg6NDc6MjMgQU07My5mcHJnOzU3NDQ="/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0xNjswODo1NzozNCBBTTs4OzI2MTk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, k" type="Integer" array="False" size=""/>
            <declare name="changed" type="Boolean" array="False" size=""/>
            <output expression="&quot;Enter length of nums&quot;" newline="True"/>
            <input variable="n"/>
            <declare name="nums" type="Integer" array="True" size="n"/>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <assign variable="nums[i]" expression="Random(100)"/>
                <output expression="nums[i]" newline="True"/>
            </for>
            <declare name="min" type="Integer" array="False" size=""/>
            <assign variable="min" expression="0"/>
            <assign variable="k" expression="0"/>
            <while expression="k&lt;n">
                <for variable="i" start="k" end="n-1" direction="inc" step="1">
                    <if expression="nums[i]&lt;nums[min]">
                        <then>
                            <assign variable="min" expression="i"/>
                        </then>
                        <else/>
                    </if>
                </for>
                <declare name="tmp" type="Integer" array="False" size=""/>
                <assign variable="tmp" expression="nums[k]"/>
                <assign variable="nums[k]" expression="nums[min]"/>
                <assign variable="nums[min]" expression="tmp"/>
                <assign variable="k" expression="k+1"/>
            </while>
            <output expression="&quot;========== SORTED ========== &quot;" newline="True"/>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <output expression="nums[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
