<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-16 08:47:02 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0wMTswODo0NzoyMyBBTTsyNDk1"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0xNjswODo0NzowMiBBTTs1OzI2MTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, k" type="Integer" array="False" size=""/>
            <declare name="changed" type="Boolean" array="False" size=""/>
            <output expression="&quot;Enter length of nums&quot;" newline="True"/>
            <input variable="n"/>
            <declare name="nums" type="Integer" array="True" size="n"/>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <input variable="nums[i]"/>
            </for>
            <assign variable="changed" expression="True"/>
            <while expression="changed==True">
                <assign variable="changed" expression="False"/>
                <for variable="i" start="0" end="n-2" direction="inc" step="1">
                    <if expression="nums[i]&gt;nums[i+1]">
                        <then>
                            <declare name="tmp" type="Integer" array="False" size=""/>
                            <assign variable="tmp" expression="nums[i+1]"/>
                            <assign variable="nums[i+1]" expression="nums[i]"/>
                            <assign variable="nums[i]" expression="tmp"/>
                            <assign variable="changed" expression="True"/>
                        </then>
                        <else/>
                    </if>
                </for>
            </while>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <output expression="nums[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
