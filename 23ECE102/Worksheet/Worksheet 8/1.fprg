<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 08:54:25 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0wMTswODo0NzoyMyBBTTsyNDk1"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0wMTswODo1NDoyNSBBTTsyOzI2MDQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, sum" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter length of nums&quot;" newline="True"/>
            <input variable="n"/>
            <assign variable="sum" expression="0"/>
            <declare name="nums" type="Integer" array="True" size="n"/>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <input variable="nums[i]"/>
            </for>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <assign variable="sum" expression="sum+nums[i]"/>
            </for>
            <output expression="&quot;Sum of the array element is &quot;&amp;sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
