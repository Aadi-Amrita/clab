<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 08:39:24 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0wMTswODozNTo0MiBBTTsyNDkz"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0xMC0wMTswODozOToyNCBBTTsyOzI2MDY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, sum" type="Integer" array="False" size=""/>
            <assign variable="sum" expression="0"/>
            <output expression="&quot;How many resistors do you have in series?&quot;" newline="True"/>
            <input variable="n"/>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <declare name="r" type="Integer" array="False" size=""/>
                <output expression="&quot;Enter resistance for R&quot;&amp;(i+1)" newline="True"/>
                <input variable="r"/>
                <assign variable="sum" expression="sum+r"/>
            </for>
            <output expression="&quot;Equivalent series resistance is &quot;&amp;sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
