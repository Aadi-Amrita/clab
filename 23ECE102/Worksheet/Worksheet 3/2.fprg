    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="time, hours, mins" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter time in minutes&quot;" newline="True"/>
            <input variable="time"/>
            <assign variable="hours" expression="time/60"/>
            <assign variable="mins" expression="time%60"/>
            <output expression="&quot;You were parked for &quot; &amp; hours &amp; &quot; hours and &quot; &amp; minutes &amp; &quot; minutes &quot;" newline="True"/>
        </body>
    </function>
