<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1"/>
        <attribute name="authors" value="year1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-25 10:15:47 AM"/>
        <attribute name="created" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOS0xMTswODoyNzowOSBBTTsyNTA2"/>
        <attribute name="edited" value="eWVhcjE7RUNFQ0wtU1lTMTM7MjAyNi0wOS0yNTsxMDoxNTo0NyBBTTs1OzI2MTU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="m, n, l, i, j" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter the width of the matrix&quot;" newline="True"/>
            <input variable="m"/>
            <output expression="&quot;Enter the height of the matrix&quot;" newline="True"/>
            <input variable="n"/>
            <assign variable="l" expression="m*n"/>
            <declare name="a" type="Integer" array="True" size="l"/>
            <for variable="i" start="0" end="l-1" direction="inc" step="1">
                <declare name="c, b" type="Integer" array="False" size=""/>
                <assign variable="c" expression="i%m"/>
                <assign variable="b" expression="i/m"/>
                <output expression="&quot;Enter the value for the element &quot; &amp; c &amp; &quot;,&quot; &amp; b" newline="True"/>
                <input variable="a[i]"/>
            </for>
            <declare name="b" type="Integer" array="True" size="l"/>
            <for variable="i" start="0" end="l-1" direction="inc" step="1">
                <declare name="c, d" type="Integer" array="False" size=""/>
                <assign variable="c" expression="i%m"/>
                <assign variable="d" expression="i/m"/>
                <output expression="&quot;Enter the value for the element &quot; &amp; c &amp; &quot;,&quot; &amp; d" newline="True"/>
                <input variable="b[i]"/>
            </for>
            <declare name="c" type="Integer" array="True" size="l"/>
            <for variable="i" start="0" end="l-1" direction="inc" step="1">
                <assign variable="c[i]" expression="a[i]+b[i]"/>
            </for>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <declare name="out" type="String" array="False" size=""/>
                <assign variable="out" expression="&quot;&quot;"/>
                <for variable="j" start="0" end="m-1" direction="inc" step="1">
                    <assign variable="out" expression="out &amp; &quot; &quot; &amp; c[i*m+j]"/>
                </for>
                <output expression="out" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
